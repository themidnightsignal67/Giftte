# GEMINI API keys for giftte Intelligence live gift curation.
# Prefer a comma-separated list so the server can rotate if one key
# hits rate limits or becomes invalid:
#
#   GEMINI_API_KEYS="key1,key2,key3"
#
# You can also use single keys (still supported):
#   GEMINI_API_KEY="key1"
#   GEMINI_API_KEY_2="key2"
#   GEMINI_API_KEY_3="key3"
#
# In AI Studio: set these inside Settings > Secrets.
# For self-hosting / local: copy this file to .env and fill real values.
# NEVER commit real keys — .env is gitignored.

GEMINI_API_KEYS="YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2,YOUR_GEMINI_API_KEY_3"

# Optional single-key fallbacks (used if GEMINI_API_KEYS is empty):
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# GEMINI_API_KEY_2="YOUR_SECOND_KEY"
# GEMINI_API_KEY_3="YOUR_THIRD_KEY"

# PORT: Server listening port (defaults to 3000)
PORT="3000"

# APP_URL: Public URL where your giftte deployment is hosted.
APP_URL="YOUR_APP_URL"
