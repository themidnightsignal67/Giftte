# GEMINI_API_KEY: Required for giftte Intelligence live gift curation.
# In AI Studio: set GEMINI_API_KEY inside Settings > Secrets.
# For self-hosting or local Node runs: copy this file to .env and add your key below.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PORT: Server listening port (defaults to 3000)
PORT="3000"

# APP_URL: Public URL where your giftte deployment is hosted.
APP_URL="YOUR_APP_URL"
